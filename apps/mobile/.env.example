# ============================================================
#  apps/mobile/.env.example  —  PUBLIC VALUES ONLY
#  Copy to apps/mobile/.env and fill in.
#  NEVER put provider or service keys in EXPO_PUBLIC_* variables.
# ============================================================

# Deployed API (Vercel) or http://localhost:3000 in local dev
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
