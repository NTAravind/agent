# ============================================================
#  apps/api/.env.example  —  SERVER SECRETS (never in the mobile app)
#  Copy to apps/api/.env.local and fill in. Same values go in Vercel.
# ============================================================

# --- Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Allow-list (Dashboard → Authentication → Users → your row → id) ---
ALLOWED_USER_ID=00000000-0000-0000-0000-000000000000

# --- Inngest (app.inngest.com → your app → keys) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only: use the Inngest dev server instead of the cloud.
# INNGEST_DEV=1

# --- LLM providers (Phase 0.5+) ---
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Mistral, DeepSeek, Hugging Face, Cohere (added later; key any subset)
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Hugging Face: a user access token (hf_…) from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Cohere free trial keys are for non-commercial use only.
COHERE_API_KEY=

# --- Integration providers (Phase 6) ---
# https://composio.com → Settings → Project Settings → API Keys. Must be a
# Platform API key (ak_…); a Connect consumer key (ck_…) is rejected.
# Server-only; the Composio marketplace listing fails fast without it.
COMPOSIO_API_KEY=
# Optional: override the auto-derived callback URL for Composio hosted auth.
# If unset, uses VERCEL_URL/VERCEL_PROJECT_PRODUCTION_URL or localhost:3000.
# MCP_COMPOSIO_CALLBACK_URL=https://your-domain.com/api/mcp/composio/callback

# --- Later phases (leave empty for now) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
ENCRYPTION_KEY=
TAVILY_API_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_VAULT_BRANCH=main
GITHUB_VAULT_TOKEN=
GITHUB_VAULT_REPO=owner/repo
SEARCH_API_KEY=
